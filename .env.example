# Copia este archivo a .env.local y llena los valores (Claude no escribe .env).
# Ambos valores son públicos (los ve el navegador) y están en Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# SOLO servidor (Vercel / GitHub Actions). Nunca en el cliente ni en el repositorio.
# SUPABASE_URL=                 # también como secreto de GitHub Actions (worker, process-book.yml)
# SUPABASE_SERVICE_ROLE_KEY=    # también como secreto de GitHub Actions
# GITHUB_DISPATCH_TOKEN=        # solo Vercel: dispara process-book.yml (repository_dispatch)
