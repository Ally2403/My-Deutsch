{
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "settings": { "onlyCategories": ["performance", "accessibility", "best-practices"] }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.85, "aggregationMethod": "median-run" }],
        "categories:accessibility": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }],
        "categories:best-practices": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }]
      }
    }
  }
}
